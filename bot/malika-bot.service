# Telegram bot — systemd unit template.
#
#   sudo cp bot/malika-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now malika-bot
#
# Adjust User, WorkingDirectory and EnvironmentFile to the server. The bot polls
# outward, so nothing needs to be opened in the firewall.

[Unit]
Description=Malika Bobonazarova blog — Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=malika
Group=malika

# The repository working copy the bot commits into. It needs a git identity with
# push access — an SSH deploy key with write access is the usual arrangement.
WorkingDirectory=/srv/malika

# Token and allowlist. Without the allowlist the bot refuses to start rather
# than serving everyone, so a missing file is a safe failure.
EnvironmentFile=/etc/malika-bot.env

ExecStart=/usr/bin/node bot/src/index.mjs

# Long polling drops out whenever the network does; coming back is routine.
Restart=always
RestartSec=5

# Unfinished flows live here and must outlive a restart.
StateDirectory=malika-bot
Environment=BOT_STATE_DIR=/var/lib/malika-bot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/malika /var/lib/malika-bot

[Install]
WantedBy=multi-user.target
