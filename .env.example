# Analytics. Cookieless, no personal data stored — see /maxfiylik.
# Leave both unset to ship with no analytics at all (dev and CI always do).
#
# Plausible (EU-hosted, the default):
PUBLIC_ANALYTICS_DOMAIN=malika-bobonazarova.uz
# PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#
# Or a self-hosted Umami:
# PUBLIC_ANALYTICS_DOMAIN=malika-bobonazarova.uz
# PUBLIC_ANALYTICS_SRC=https://umami.example.com/script.js

# ---------------------------------------------------------------- analytics API
# Read at BUILD TIME only. Never prefixed PUBLIC_ — these must not reach the browser.
# Leave unset to build with no view counters and an empty stats page; the build
# still succeeds either way.
#
# Self-hosted Umami (the default, and what /admin/statistika expects):
# ANALYTICS_PROVIDER=umami
# UMAMI_API_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_API_KEY=...                 # Umami Cloud
# UMAMI_USERNAME=...                # or self-hosted login
# UMAMI_PASSWORD=...
#
# Plausible — only if the plan in use includes Stats API access:
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_SITE_ID=malika-bobonazarova.uz
# PLAUSIBLE_API_KEY=...
# PLAUSIBLE_API_URL=https://plausible.io

# ------------------------------------------------------------------ admin auth
# Basic auth for /admin/*, enforced at the edge (middleware.ts on Vercel,
# functions/admin/_middleware.js on Cloudflare Pages). Fails CLOSED: if these are
# unset the admin area returns 503 rather than becoming public.
# ADMIN_USER=malika
# ADMIN_PASSWORD=
