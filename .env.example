# Analytics. Cookieless, no personal data stored — see /maxfiylik.
# Leave both unset to ship with no analytics at all (dev and CI always do).
#
# Plausible (EU-hosted, the default):
PUBLIC_ANALYTICS_DOMAIN=malika-bobonazarova.uz
# PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#
# Or a self-hosted Umami:
# PUBLIC_ANALYTICS_DOMAIN=malika-bobonazarova.uz
# PUBLIC_ANALYTICS_SRC=https://umami.example.com/script.js

# ---------------------------------------------------------------- analytics API
# Read at BUILD TIME only. Never prefixed PUBLIC_ — these must not reach the browser.
# Leave unset to build with no view counters and an empty stats page; the build
# still succeeds either way.
#
# Self-hosted Umami (the default, and what /admin/statistika expects):
# ANALYTICS_PROVIDER=umami
# UMAMI_API_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_API_KEY=...                 # Umami Cloud
# UMAMI_USERNAME=...                # or self-hosted login
# UMAMI_PASSWORD=...
#
# Plausible — only if the plan in use includes Stats API access:
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_SITE_ID=malika-bobonazarova.uz
# PLAUSIBLE_API_KEY=...
# PLAUSIBLE_API_URL=https://plausible.io

# ------------------------------------------------------------------ admin auth
# Basic auth for /admin/*, enforced by src/middleware.ts inside the app. Read at
# request time, so changing them needs a restart but not a rebuild. Fails CLOSED:
# if these are unset the admin area returns 503 rather than becoming public.
# ADMIN_USER=malika
# ADMIN_PASSWORD=

# --------------------------------------------------------------------- CMS
# Keystatic. The PUBLIC_ ones are bundled into the browser and are not secrets;
# keystatic.config.ts can only read import.meta.env, never process.env.
# PUBLIC_KEYSTATIC_STORAGE=github          # omit locally — dev defaults to local files
# PUBLIC_KEYSTATIC_GITHUB_OWNER=tengdosh
# PUBLIC_KEYSTATIC_GITHUB_REPO=malika
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=...     # NOT NEXT_PUBLIC_ — this is Astro
#
# Server-side only. Set these in the hosting dashboard, never in a file.
# KEYSTATIC_GITHUB_CLIENT_ID=...
# KEYSTATIC_GITHUB_CLIENT_SECRET=...
# KEYSTATIC_SECRET=                        # random 64-character string

# --------------------------------------------------------------- Telegram bot
# bot/ — a second client onto this same repository. See README > Telegram bot.
# The bot has WRITE ACCESS to the content, so the allowlist is the whole of its
# security. Read at start-up: changing either needs a restart.
#
# TELEGRAM_BOT_TOKEN=...                  # from @BotFather. A secret.
#
# Numeric Telegram user IDs, comma-separated. NEVER usernames: a username can be
# given up and re-registered by someone else, and the bot would inherit them.
# Unset means the bot serves NOBODY and refuses to start — that default is
# deliberate. @userinfobot tells you an id.
# TELEGRAM_ALLOWED_IDS=111111111,222222222
#
# Optional. Defaults are usually right.
# BOT_REPO_DIR=/srv/malika                # working copy the bot commits into
# BOT_STATE_DIR=/var/lib/malika-bot       # unfinished flows; never inside the repo
# BOT_MAX_IMAGE_BYTES=12582912            # covers larger than this are refused
# BOT_REBUILD_COMMAND=                    # run after a push, e.g. scripts/rebuild.sh
