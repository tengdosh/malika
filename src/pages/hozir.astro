---
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../lib/format';

const now = await getEntry('site', 'now');
if (!now) throw new Error('src/content/site/now.md is missing');

const { Content } = await render(now);
const { description, updated } = now.data;
---

<Base title="Hozir" description={description}>
  <div class="shell page-head">
    <h1>Hozir</h1>
    {
      updated && (
        <p class="footer__credential">
          Oxirgi yangilanish: <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
        </p>
      )
    }
  </div>

  <div class="shell" style="padding-bottom:clamp(3rem,7vw,5rem)">
    <div class="prose">
      <Content />
    </div>
  </div>
</Base>
