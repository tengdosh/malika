---
import { getEntry, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/settings';

const page = await getEntry('site', 'maxfiylik');
if (!page) throw new Error('src/content/site/maxfiylik/index.md is missing');

const { Content } = await render(page);
const settings = await getSettings();
---

<Base title={page.data.title} description={page.data.description}>
  <div class="shell page-head">
    <h1>{page.data.title}</h1>
  </div>

  <div class="shell" style="padding-bottom:clamp(3rem,7vw,5rem)">
    <div class="prose">
      <Content />

      <h2>Savolingiz boʻlsa</h2>
      {
        settings.telegram ? (
          <p>
            Menga <a href={settings.telegram} rel="noopener">Telegram</a> orqali yozishingiz mumkin.
          </p>
        ) : settings.email ? (
          <p>
            Menga <a href={`mailto:${settings.email}`}>{settings.email}</a> orqali yozishingiz mumkin.
          </p>
        ) : (
          <p>Bogʻlanish uchun havola tez orada shu yerda paydo boʻladi.</p>
        )
      }
    </div>
  </div>
</Base>
