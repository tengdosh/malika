---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import PreloadImage from '../components/PreloadImage.astro';
import Signature from '../components/Signature.astro';
import { personJsonLd } from '../lib/jsonld';
import { SITE } from '../lib/site.js';

const about = await getEntry('site', 'men-haqimda');
if (!about) throw new Error('src/content/site/men-haqimda.md is missing');

const { Content } = await render(about);
const { portrait, portraitAlt, description } = about.data;

const PORTRAIT_WIDTHS = [320, 640];
const PORTRAIT_SIZES = '(min-width: 52rem) 20rem, min(100vw, 20rem)';
---

<Base title="Men haqimda" description={description} jsonLd={[personJsonLd()]}>
  {portrait && (
    <Fragment slot="head">
      <PreloadImage src={portrait} widths={PORTRAIT_WIDTHS} sizes={PORTRAIT_SIZES} />
    </Fragment>
  )}
  <div class="shell article">
    <div class="hero__grid" style="align-items:start">
      {
        portrait && (
          <div class="hero__portrait">
            <Image
              src={portrait}
              widths={PORTRAIT_WIDTHS}
              sizes={PORTRAIT_SIZES}
              alt={portraitAlt ?? ''}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }

      <div>
        <h1>Men haqimda</h1>
        <div class="prose" style="margin-top:1.5rem">
          <Content />
        </div>
        <Signature />
      </div>
    </div>
  </div>

  <div class="shell" style="padding-bottom:clamp(2rem,5vw,3rem)">
    <p class="footer__credential">{SITE.credential}</p>
  </div>
</Base>
