---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  book: {
    title: string;
    author: string;
    startedOn: Date;
    progress: number;
    note: string;
    cover?: ImageMetadata;
    coverAlt?: string;
  };
}

const { book } = Astro.props;
const progress = Math.round(Math.max(0, Math.min(100, book.progress)));

// Same rule as post covers: an image with no alt text is withheld rather than
// shipped with alt="", which would be a meaningful image invisible to screen
// readers. The card reads fine without it.
const coverAlt = book.coverAlt?.trim();
const showCover = Boolean(book.cover && coverAlt);
---

<section class="shell section" aria-labelledby="oqiyapman">
  <div class="reading">
    {
      showCover && book.cover && coverAlt && (
        <div class="reading__cover">
          <Picture
            src={book.cover}
            formats={['avif', 'webp']}
            widths={[128, 256]}
            sizes="8rem"
            alt={coverAlt}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }

    <div>
      <span class="reading__label" id="oqiyapman">Hozir oʻqiyapman</span>
      <h3>{book.title}</h3>
      <p class="reading__author">{book.author}</p>
      <p class="reading__note">{book.note}</p>

      <div class="reading__progress">
        <div
          class="reading__track"
          role="progressbar"
          aria-valuenow={progress}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label="Kitobning oʻqilgan qismi"
        >
          <div class="reading__fill" style={`width:${progress}%`}></div>
        </div>
        <p class="reading__pct">{progress}% oʻqildi</p>
      </div>
    </div>
  </div>
</section>
