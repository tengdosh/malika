---
import { SITE } from '../lib/site.js';
import { formatDate, isoDate, formatCount } from '../lib/format';

interface Props {
  date: Date;
  updated?: Date;
  reviewedBy?: string;
  /** Notes show "Yangilanib boradi" rather than a publish date. */
  evergreen?: boolean;
  /**
   * All-time reads, or undefined to render nothing. Baked in at build time —
   * see src/lib/analytics. Sits with the other metadata rather than as a badge.
   */
  views?: number;
}

const { date, updated, reviewedBy, evergreen = false, views } = Astro.props;
---

<div class="byline">
  <!-- TODO(portrait): replace with a real cropped avatar once photos exist. -->
  <span class="byline__avatar" aria-hidden="true">M</span>

  <div>
    <p class="byline__name">{SITE.name}</p>
    <p class="byline__line">
      {SITE.credential}
      {' · '}
      {
        evergreen ? (
          <span>Yangilanib boradi</span>
        ) : (
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
        )
      }
      {
        updated && (
          <>
            {' · yangilangan '}
            <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
          </>
        )
      }
      {views !== undefined && <>{' · '}{formatCount(views)} marta oʻqildi</>}
    </p>
    {reviewedBy && <p class="byline__reviewed">{reviewedBy} tomonidan koʻrib chiqilgan</p>}
  </div>
</div>
