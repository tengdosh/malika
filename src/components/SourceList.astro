---
interface Source {
  title: string;
  publisher: string;
  year?: number;
  url?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{
  /* Hidden when empty. The schema forbids empty on koz-sogligi posts, so a
     health post can never reach this component with nothing to cite. */
  sources.length > 0 && (
    <section class="sources" aria-labelledby="manbalar">
      <h2 id="manbalar">Manbalar</h2>
      <ol>
        {sources.map((source) => (
          <li>
            <cite>{source.title}</cite>
            {' — '}
            {source.publisher}
            {source.year && `, ${source.year}`}
            {source.url && (
              <>
                {' · '}
                <a href={source.url} rel="noopener nofollow">manba</a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
