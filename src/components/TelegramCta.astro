---
import { getSettings } from '../lib/settings';

// Renders nothing until a Telegram handle is set in the admin. A subscribe block
// with a dead button is worse than no subscribe block.
const { telegram } = await getSettings();
---

{
  /* A plain outbound link. No form, no newsletter, no lead capture. */
  telegram && (
    <section class="shell section">
      <div class="cta">
        <h2>Yangi yozuvlardan xabardor boʻling</h2>
        <p>Har bir yangi yozuvni Telegram kanalimga qoʻyaman. Boshqa hech narsa yubormayman.</p>
        <a class="button" href={telegram} rel="noopener">Telegram kanalim</a>
      </div>
    </section>
  )
}
