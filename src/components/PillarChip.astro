---
import { PILLAR_LABEL, type Pillar } from '../lib/pillars';
import { withBase } from '../lib/site.js';

interface Props {
  pillar: Pillar;
  /** Chips link to the filtered index unless this is false (e.g. inside a heading). */
  link?: boolean;
}

const { pillar, link = true } = Astro.props;
const label = PILLAR_LABEL[pillar];
const href = withBase(
  pillar === 'koz-sogligi' ? '/koz-sogligi' : `/yozuvlar/mavzu/${pillar}`,
);
---

{
  link ? (
    <a class="pillar-chip" href={href}>{label}</a>
  ) : (
    <span class="pillar-chip">{label}</span>
  )
}
