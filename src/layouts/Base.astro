---
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { SITE, withBase } from '../lib/site.js';
import { getSettings } from '../lib/settings';
import { FONT_FILES } from '../../scripts/font-manifest.mjs';
import '../styles/global.css';

const PRELOAD_FONTS = FONT_FILES.filter((font) => font.preload);

/**
 * Pages with an above-the-fold image push a `head` slot containing a
 * <link rel="preload" as="image">. Without it the LCP image is only discovered
 * once the HTML is parsed, costing a full round trip (measured: 1807ms LCP on
 * simulated 4G against a 755ms floor).
 */
interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL of the Open Graph image. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD blocks. Kept light — she is a person, not an institution. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Article timestamps, emitted as article:published_time / modified_time. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /**
   * altQueries from the post. Feeds meta[name=keywords] ONLY — never visible
   * text and never a hidden div. Injecting search variants into the body is
   * cloaking, and on a YMYL page it does real damage.
   */
  keywords?: string[];
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.png',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  keywords = [],
} = Astro.props;

/**
 * Analytics tag.
 *
 * The two supported providers identify a site differently, and getting this
 * wrong is silent: the script loads, reports no error, and records nothing.
 *
 *   Plausible  data-domain="example.uz"
 *   Umami      data-website-id="<uuid>"
 *
 * So `PUBLIC_ANALYTICS_WEBSITE_ID` selects the Umami shape. Both attributes are
 * emitted only when set, and the tag itself only when a domain is configured —
 * dev and CI ship no analytics at all.
 */
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const analyticsWebsiteId = import.meta.env.PUBLIC_ANALYTICS_WEBSITE_ID;
const analyticsSrc =
  import.meta.env.PUBLIC_ANALYTICS_SRC ?? 'https://plausible.io/js/script.js';

/**
 * Canonical + indexing.
 *
 * On a preview deployment (a different origin, or a subpath under someone
 * else's domain) the whole site is noindexed: letting Google index the same
 * content under two hostnames is worse than not being indexed yet.
 */
const previewDeploy = import.meta.env.PUBLIC_NOINDEX === '1';
const origin = import.meta.env.PUBLIC_SITE_ORIGIN || SITE.origin;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', origin);

// Rendered only when the corresponding field is filled in.
const settings = await getSettings();
const verification = [
  { name: 'google-site-verification', content: settings.googleSiteVerification },
  { name: 'yandex-verification', content: settings.yandexVerification },
  { name: 'msvalidate.01', content: settings.bingVerification },
].filter((tag): tag is { name: string; content: string } => Boolean(tag.content));
const ogImageUrl = new URL(withBase(ogImage), origin);
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang="uz" data-theme="light" data-textsize="md">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {(noindex || previewDeploy) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="uz_UZ" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    {/* Self-referencing hreflang. Harmless today, correct the day /ru exists. */}
    <link rel="alternate" hreflang="uz" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />

    {
      /* Search-console verification tokens, pasted in from the admin. DNS TXT
         verification is preferable and needs none of these — see the docs. */
      verification.map((tag) => <meta name={tag.name} content={tag.content} />)
    }

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={withBase("/rss.xml")} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    {
      /* Exactly the two faces that render above the fold: the body face and the
         display face the LCP heading is set in. The other five arrive lazily with
         font-display:swap. Driven by scripts/font-manifest.mjs so this list cannot
         drift from what public/fonts actually contains. */
      PRELOAD_FONTS.map((font) => (
        <link rel="preload" as="font" type="font/woff2" href={withBase(`/fonts/${font.to}`)} crossorigin />
      ))
    }

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }

    <!--
      Restores theme and text size BEFORE first paint so there is no flash of the
      wrong state. This snippet and the control wiring below are the only scripts
      on the site (plus the analytics tag).
    -->
    <script is:inline>
      (function () {
        try {
          var el = document.documentElement;
          var theme = localStorage.getItem('theme');
          if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          el.setAttribute('data-theme', theme);

          var size = localStorage.getItem('textsize');
          el.setAttribute('data-textsize', size === 'lg' || size === 'xl' ? size : 'md');
        } catch (err) {
          /* private mode / storage disabled — the server-rendered defaults stand */
        }
      })();
    </script>

    {
      /* Cookieless, EU-hosted, no personal data. Loaded only in production and
         only when a domain is configured, so dev and CI never phone home.
         Point ANALYTICS_SRC at a self-hosted Umami to switch providers. */
      analyticsDomain && import.meta.env.PROD && (
        <script
          is:inline
          defer
          data-domain={analyticsDomain}
          data-website-id={analyticsWebsiteId}
          src={analyticsSrc}
        />
      )
    }

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#asosiy">Asosiy mazmunga oʻtish</a>

    <Masthead />

    <main id="asosiy">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (function () {
        var el = document.documentElement;

        function save(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (err) {
            /* storage disabled; the choice still applies for this page view */
          }
        }

        function syncPressed() {
          var size = el.getAttribute('data-textsize') || 'md';
          document.querySelectorAll('.prefs button[data-size]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(btn.dataset.size === size));
          });
          var dark = el.getAttribute('data-theme') === 'dark';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(dark));
          });
        }

        document.addEventListener('click', function (event) {
          var sizeButton = event.target.closest('.prefs button[data-size]');
          if (sizeButton) {
            el.setAttribute('data-textsize', sizeButton.dataset.size);
            save('textsize', sizeButton.dataset.size);
            syncPressed();
            return;
          }

          if (event.target.closest('[data-theme-toggle]')) {
            var next = el.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            el.setAttribute('data-theme', next);
            save('theme', next);
            syncPressed();
          }
        });

        syncPressed();
      })();
    </script>
  </body>
</html>
